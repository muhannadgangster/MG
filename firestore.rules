rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.username is string && data.username.size() >= 1 &&
             data.displayName is string && data.displayName.size() >= 1 &&
             data.email is string;
    }

    function isValidVideo(data) {
      return data.creatorId is string && data.creatorId.size() >= 1 &&
             data.title is string && data.title.size() >= 1 &&
             data.category is string;
    }

    function isValidComment(data) {
      return data.videoId is string && data.videoId.size() >= 1 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.text is string && data.text.size() >= 1;
    }

    function isValidVideoLike(data) {
      return data.videoId is string && data.videoId.size() >= 1 &&
             data.userId is string && data.userId == request.auth.uid;
    }

    function isValidChatMessage(data) {
      return data.conversationId is string &&
             data.senderId is string && data.senderId == request.auth.uid &&
             data.receiverId is string && data.receiverId.size() >= 1 &&
             data.text is string && data.text.size() >= 1;
    }

    function isValidUserPresence(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.isOnline is bool;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if isOwner(userId);
    }

    // --- Videos Collection ---
    match /videos/{videoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && incoming().creatorId == request.auth.uid && isValidVideo(incoming());
      allow update: if isAuthenticated() && (
        isOwner(resource.data.creatorId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes', 'comments', 'shares', 'saves'])
      );
      allow delete: if isAuthenticated() && isOwner(resource.data.creatorId);
    }

    // --- Comments Collection ---
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && incoming().userId == request.auth.uid && isValidComment(incoming());
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // --- Video Likes Collection ---
    match /video_likes/{likeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && incoming().userId == request.auth.uid && isValidVideoLike(incoming());
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // --- Chat Messages Collection ---
    match /chat_messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid
      );
      allow create: if isAuthenticated() && incoming().senderId == request.auth.uid && isValidChatMessage(incoming());
      allow update: if isAuthenticated() && resource.data.receiverId == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }

    // --- Presence Collection ---
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isValidUserPresence(incoming());
    }
  }
}
